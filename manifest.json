{
  "manifest_version": 3,
  "name": "Sophos Central Coach",
  "version": "0.1.0",
  "description": "Contextual field guide sidebar for Sophos Central — talk tracks, discovery questions, objections, and competitive intel as you navigate.",

  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "*://*.cloud.sophos.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.cloud.sophos.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "action": {
    "default_title": "Sophos Central Coach",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
